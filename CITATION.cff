    title: SeedVR
    authors:
      - name: ByteDance Seed
    repository-code: https://github.com/ByteDance-Seed/SeedVR
    license: Apache-2.0
  - type: software
    title: SeedVR2-3B
    authors:
      - name: ByteDance Seed
    url: https://huggingface.co/ByteDance-Seed/SeedVR2-3B
